          "name": "Get Shannon Session",
          "request": {
            "name": "Get Shannon Session",
            "description": {
              "content": "Return the active session for a given application/service pair at a given block height. Sessions group applications and suppliers for the duration of a session window.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pocket",
                "session",
                "v1",
                "get_session"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
