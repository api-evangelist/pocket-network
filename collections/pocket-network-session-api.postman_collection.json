                  "disabled": false,
                  "key": "application_address",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "service_id",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "block_height",
                  "value": "<integer>"
                }
              ],
